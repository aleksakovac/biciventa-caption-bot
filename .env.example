# Copia este archivo como ".env" para probar en tu compu, o carga estas
# mismas variables en el panel de "Environment" de Render.

# Token que te da @BotFather al crear el bot (ver README, paso 1).
TELEGRAM_BOT_TOKEN=

# Cualquier string aleatorio y largo, tú lo inventas. Es parte de la URL
# secreta del webhook para que nadie más pueda mandarle updates al bot.
# Ejemplo para generar uno: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=

# Tu API key de Gemini (aistudio.google.com -> Get API key). El tier
# gratuito de Gemini Flash alcanza sin pagar nada para este uso.
GEMINI_API_KEY=

# Opcional. Tu user id de Telegram (te lo da @userinfobot), separado por
# comas si quieres permitir más de uno. Si lo dejas vacío, cualquiera que le
# escriba al bot puede generar captions gastando tu cuota gratuita.
ALLOWED_USER_IDS=

# Opcional. Modelo de Gemini a usar. Por defecto uno rápido y gratuito
# (Flash); revisa nombres/tiers vigentes en ai.google.dev/gemini-api/docs/pricing.
GEMINI_MODEL=gemini-3.6-flash

# --- Proveedor de IA alternativo (opcional, para experimentar) ---
# Por defecto el bot usa Gemini (arriba). Si querés probar Groq (mismo
# resultado, gratis, pero mucho más rápido — 1-3s en vez de 20-30s), llená
# estas dos variables. Con AI_PROVIDER sin definir o en "gemini", estas se
# ignoran por completo y el bot sigue como siempre.
AI_PROVIDER=gemini

# Tu API key de Groq (console.groq.com/keys, gratis, sin tarjeta). Solo
# hace falta si AI_PROVIDER=groq.
GROQ_API_KEY=

# Opcional. Modelo de Groq a usar (solo si AI_PROVIDER=groq). Por defecto
# el modelo insignia gratuito; revisa el catálogo vigente en
# console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b
